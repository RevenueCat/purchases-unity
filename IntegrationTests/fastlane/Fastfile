# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  before_all do
    setup_circle_ci
  end

  desc "Archive"
  lane :archive do |options|

    workspace = options[:workspace]
    project = options[:project]
    fail ArgumentError, "missing workspace or project" unless workspace || project

    archive_path = gym(
      export_method: "app-store",
      workspace: workspace,
      project: project,
      skip_codesigning: true,
      skip_package_ipa: true
    )

    # The project-based CI build uses SPM; CocoaPods builds use a workspace.
    if project
      app_paths = Dir.glob("#{archive_path}/Products/Applications/*.app")
      unless app_paths.length == 1
        UI.user_error!("Expected one app in #{archive_path}, found #{app_paths.length}")
      end
      app_path = app_paths.first

      # Xcode can archive successfully with links to bundles outside the app.
      missing = ["RevenueCat_RevenueCat.bundle", "RevenueCat_RevenueCatUI.bundle"].reject do |bundle|
        bundle_path = "#{app_path}/#{bundle}"
        File.directory?(bundle_path) && !File.symlink?(bundle_path)
      end
      unless missing.empty?
        UI.user_error!("Swift package resource bundles missing or symlinked in #{app_path}: #{missing.join(', ')}")
      end
    end
  end

end
