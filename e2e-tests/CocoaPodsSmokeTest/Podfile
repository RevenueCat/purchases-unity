source 'https://cdn.cocoapods.org/'
platform :ios, '13.0'

# TODO: before merging 11.0-dev into main, pin the PHC release and change :branch to :tag. (SDK-4602)
phc_version = '21.0-dev'
native_ios_version = '5.103.0'

target 'UnityFramework' do
  pod 'RevenueCat', :git => 'https://github.com/RevenueCat/purchases-ios.git', :tag => native_ios_version
  pod 'RevenueCatUI', :git => 'https://github.com/RevenueCat/purchases-ios.git', :tag => native_ios_version
  pod 'PurchasesHybridCommon', :git => 'https://github.com/RevenueCat/purchases-hybrid-common.git', :branch => phc_version
  pod 'PurchasesHybridCommonUI', :git => 'https://github.com/RevenueCat/purchases-hybrid-common.git', :branch => phc_version
end

target 'Unity-iPhone' do
end

use_frameworks! :linkage => :static
